#!/bin/bash
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

echo "==> Generating LaTeX from JSON..."
python3 generator/generate_resume.py

echo "==> Compiling PDF..."
pdflatex -interaction=nonstopmode resume.tex > /dev/null 2>&1

echo "==> Running checks..."
python3 generator/check_resume.py resume.pdf
echo "==> Done."
